---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
    product: CollectionEntry<"menu">["data"][number];
}

const { product } = Astro.props;
---

<div class="group flex flex-col items-center text-center scroll-fade-in">
    <div
        class="w-full aspect-square rounded-full overflow-hidden mb-4 sm:mb-6 shadow-lg sm:shadow-xl relative"
    >
        <Image
            src={product.thumbnail}
            widths={[160, 240, 320, 480, 640]}
            sizes="(min-width: 1024px) 18rem, (min-width: 768px) 30vw, 45vw"
            class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
            alt={product.name}
        />
    </div>
    <h3
        class="text-lg sm:text-xl font-serif font-bold text-gray-900 mb-2 sm:mb-3"
    >
        {product.name}
    </h3>
    <p class="text-gray-500 text-sm leading-relaxed px-1 sm:px-4 text-pretty">
        {product.description}
    </p>
</div>
