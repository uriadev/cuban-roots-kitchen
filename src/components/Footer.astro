                    </li>
                    <li>
                        <a
                            class="hover:text-primary transition-colors"
                            href="#menu-chapters">About</a
                        >
                    </li>
                    <li>
                        <a
                            class="hover:text-primary transition-colors"
                            href="#gallery">Menu</a
                        >
                    </li>
                    <li>
                        <a
                            class="hover:text-primary transition-colors"
                            href="#contact">Contact</a
