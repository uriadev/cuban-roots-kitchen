---
import { UtensilsCrossed, Menu, X } from "@lucide/astro";
---

<header class="sticky top-0 z-100 w-full bg-white shadow-sm">
    <div
        class="max-w-350 mx-auto px-4 md:px-10 py-5 flex items-center justify-between"
    >
        <div class="flex items-center gap-2 text-text-light">
            <a class="flex items-center gap-2" href="/">
                <UtensilsCrossed class="text-3xl text-primary" />
                <h2
                    class="text-2xl font-serif font-bold tracking-tight text-gray-800"
                >
                    Cuba Route
                </h2>
            </a>
        </div>
        <div class="hidden md:flex items-center gap-10">
            <nav class="flex items-center gap-8">
                <a
                    class="text-gray-600 hover:text-primary font-medium text-sm transition-colors"
                    href="/">Home</a
                >
                <a
                    class="text-gray-600 hover:text-primary font-medium text-sm transition-colors"
                    href="/#story-section">About</a
                >
                <a
                    class="text-gray-600 hover:text-primary font-medium text-sm transition-colors"
                    href="/menu">Menu</a
                >
                <a
                    class="text-gray-600 hover:text-primary font-medium text-sm transition-colors"
                    href="#contact">Contact</a
                >
            </nav>
            {
                /*<button
                        class="px-6 py-2 border border-gray-300 hover:border-primary hover:text-primary rounded-full text-sm font-semibold transition-all">
                        Order Now
                    </button>*/
            }
        </div>
        <button
            id="mobile-menu-toggle"
            type="button"
            class="md:hidden flex items-center justify-center text-text-light"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label="Open menu"
        >
            <Menu class="menu-icon" />
            <X class="close-icon hidden" />
        </button>
    </div>
    <nav
        id="mobile-menu"
        class="hidden md:hidden border-t border-gray-100 bg-white shadow-sm"
        aria-label="Mobile"
    >
        <div class="max-w-350 mx-auto px-4 py-2 flex flex-col">
            <a
                class="text-gray-600 hover:text-primary font-medium text-sm transition-colors py-3 border-b border-gray-100 last:border-b-0"
                href="/">Home</a
            >
            <a
                class="text-gray-600 hover:text-primary font-medium text-sm transition-colors py-3 border-b border-gray-100 last:border-b-0"
                href="/#story-section">About</a
            >
            <a
                class="text-gray-600 hover:text-primary font-medium text-sm transition-colors py-3 border-b border-gray-100 last:border-b-0"
                href="/menu">Menu</a
            >
            <a
                class="text-gray-600 hover:text-primary font-medium text-sm transition-colors py-3 border-b border-gray-100 last:border-b-0"
                href="#contact">Contact</a
            >
        </div>
    </nav>
</header>

<script>
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const menuIcon = toggle?.querySelector<SVGElement>(".menu-icon");
    const closeIcon = toggle?.querySelector<SVGElement>(".close-icon");

    function setOpen(open: boolean) {
        if (!toggle || !menu) return;
        menu.classList.toggle("hidden", !open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        menuIcon?.classList.toggle("hidden", open);
        closeIcon?.classList.toggle("hidden", !open);
    }

    toggle?.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Close when a link is tapped (e.g. in-page anchors that don't reload).
    menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
    });

    // Close on Escape, and reset when crossing the md breakpoint.
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
    });
    window
        .matchMedia("(min-width: 768px)")
        .addEventListener("change", (e) => {
            if (e.matches) setOpen(false);
        });
</script>
