---
import { UtensilsCrossed, Menu } from "@lucide/astro";
---

<header class="sticky top-0 z-100 w-full bg-white shadow-sm">
    <div
        class="max-w-350 mx-auto px-4 md:px-10 py-5 flex items-center justify-between"
    >
        <div class="flex items-center gap-2 text-text-light">
            <UtensilsCrossed class="text-3xl text-primary" />
            <h2
                class="text-2xl font-serif font-bold tracking-tight text-gray-800"
            >
                Cuba Route
            </h2>
        </div>
        <div class="hidden md:flex items-center gap-10">
            <nav class="flex items-center gap-8">
                <a
                    class="text-gray-600 hover:text-primary font-medium text-sm transition-colors"
                    href="/">Home</a
                >
                <a
                    class="text-gray-600 hover:text-primary font-medium text-sm transition-colors"
                    href="/#story-section">About</a
                >
                <a
                    class="text-gray-600 hover:text-primary font-medium text-sm transition-colors"
                    href="/menu">Menu</a
                >
                <a
                    class="text-gray-600 hover:text-primary font-medium text-sm transition-colors"
                    href="#contact">Contact</a
                >
            </nav>
            {
                /*<button
                        class="px-6 py-2 border border-gray-300 hover:border-primary hover:text-primary rounded-full text-sm font-semibold transition-all">
                        Order Now
                    </button>*/
            }
        </div>
        <button
            class="md:hidden flex items-center justify-center text-text-light"
        >
            <Menu />
        </button>
    </div>
</header>
